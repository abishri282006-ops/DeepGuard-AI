{
  "manifest_version": 3,
  "name": "DeepGuard AI",
  "version": "1.0",
  "description": "AI-powered deepfake and synthetic media detector",
  "action": {
    "default_popup": "index.html"
},
"permissions": [
    "activeTab",
    "scripting"
],
"host_permissions": [
    "https://*.wikimedia.org/*",
    "https://*.wikipedia.org/*"
],
"content_security_policy": {
  "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
},
"content_scripts": [
    {
        "matches": ["<all_urls>"],
        "js": ["content.js"]
    }
],
"web_accessible_resources": [
    {
        "resources": [
            "ort.wasm.min.mjs",
            "ort-wasm-simd-threaded.mjs",
            "ort-wasm-simd-threaded.wasm",
            "detectra_model.onnx"
        ],
        "matches": ["<all_urls>"]
    }
]
}
